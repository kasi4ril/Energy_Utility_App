# NESCO Enterprise Utility Platform Environment Configuration Template

# Database Connection Pool (PostgreSQL 16 with PostGIS & TimescaleDB)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=nesco_admin
DB_PASSWORD=nesco_master_secret_pass_2026!
DB_NAME=nesco_enterprise_db
DB_SSLMODE=disable

# Security & Cryptography Keys
HMAC_SECRET=nesco-master-hmac-integrity-key-32b!
JWT_SECRET=nesco-master-jwt-security-key-32b!!
TOKEN_EXPIRY_MINUTES=15

# Event Bus & Messaging Broker
NATS_URL=nats://127.0.0.1:4222

# Air-Gapped Local AI Sidecar (Ollama Sovereign Cluster)
AI_SIDECAR_URL=http://127.0.0.1:8001
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=mistral:instruct

# Webhook Secrets
GOOGLE_FORMS_HMAC_SECRET=nesco-google-forms-hmac-key-2026!
PAYMENT_GATEWAY_SECRET=nesco-fintech-vending-hmac-key-2026!

# Ports
PORT=8080
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

